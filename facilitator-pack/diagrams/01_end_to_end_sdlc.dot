digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.34", ranksep="0.55", splines=ortho, fontname="Arial", label="Workshop Feedback Portal — Multi-Agent SDLC", labelloc=t, fontsize=24, ratio="fill", size="13.333,7.5!"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.14,0.09", color="#CBD5E1", penwidth=1.4, fillcolor="#F8FAFC"];
  edge [fontname="Arial", fontsize=9, color="#64748B", penwidth=1.5, arrowsize=0.75];

  brief [label="Business\nRequest", fillcolor="#E0F2FE", color="#38BDF8"];
  orch [label="ORCHESTRATOR\nworkflow + gates", fillcolor="#EDE9FE", color="#8B5CF6", penwidth=2];
  ba [label="1  Business Analyst\nrequirements gathering"];
  arch [label="2  Solution Architect\narchitecture + contracts"];
  dev [label="3  Developer\ncode + tests + Terraform"];
  qa [label="4  QA Engineer\nacceptance criteria"];
  sec [label="5  Security Reviewer\nrisk + controls"];
  gate [shape=diamond, label="QA + SECURITY\nPASS?", fillcolor="#FEF3C7", color="#F59E0B"];
  ops [label="6  DevOps Engineer\nterraform validate + plan", fillcolor="#ECFDF5", color="#10B981"];
  human [shape=diamond, label="HUMAN\nAPPROVE\nDEPLOY?", fillcolor="#FEE2E2", color="#EF4444", penwidth=2];
  deploy [label="DevOps\nterraform apply", fillcolor="#ECFDF5", color="#10B981"];
  aws [label="AWS\nserverless POC", fillcolor="#FFF7ED", color="#FB923C"];
  verify [label="Smoke Test\n+ Release Report", fillcolor="#ECFDF5", color="#10B981"];
  done [label="SDLC_STATUS\nCOMPLETED", fillcolor="#DCFCE7", color="#22C55E", penwidth=2];

  {rank=same; brief; orch; ba; arch; dev;}
  {rank=same; qa; sec; gate;}
  {rank=same; ops; human; deploy; aws; verify; done;}

  brief -> orch -> ba -> arch -> dev;
  dev -> qa;
  dev -> sec;
  qa -> gate;
  sec -> gate;
  gate -> ops [xlabel="PASS"];
  gate -> dev [xlabel="FAIL → fix", color="#DC2626", constraint=false];
  ops -> human;
  human -> deploy [xlabel="APPROVE"];
  human -> ops [xlabel="REJECT", color="#DC2626", constraint=false];
  deploy -> aws -> verify -> done;
}
